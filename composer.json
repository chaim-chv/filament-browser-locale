{
  "name": "chaim-chv/filament-browser-locale",
  "description": "Automatically set Filament locale from browser preferred language",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "filament/filament": "^4.0|^5.0",
    "illuminate/support": "^11.28|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "ChaimChv\\FilamentBrowserLocale\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ChaimChv\\FilamentBrowserLocale\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ChaimChv\\FilamentBrowserLocale\\FilamentBrowserLocaleServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  }
}
